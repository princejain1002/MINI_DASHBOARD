pipeline {
    agent any

    environment {
        IMAGE_NAME = "mini_dashboard:latest"
        CONTAINER_NAME = "mini_dash"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t ${IMAGE_NAME} .'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                docker stop ${CONTAINER_NAME} || true
                docker rm ${CONTAINER_NAME} || true

                docker run -d \
                  --name ${CONTAINER_NAME} \
                  -p 8501:8501 \
                  ${IMAGE_NAME}
                '''
            }
        }
    }
}
